#!/usr/bin/env bash
# Unseals Vault with the key in Bitwarden. Needed after every Vault restart: a VM reboot, a k3s
# upgrade, a Vault upgrade Argo rolls out, or the pod being rescheduled. Linode has no KMS to
# auto-unseal with.
#
#   export BW_SESSION="$(bw unlock --raw)"
#   export KUBECONFIG=~/.kube/mediasafe.yaml
#   bootstrap/vault-unseal
#
# The key is sent to Vault's API on stdin, so it never appears in a command line — neither
# kubectl's (which the API server sees) nor one inside the pod.
set -euo pipefail

: "${BW_SESSION:?Unlock Bitwarden first: export BW_SESSION=\"\$(bw unlock --raw)\"}"
bw unlock --check --session "$BW_SESSION" >/dev/null 2>&1 \
  || { echo "BW_SESSION is stale. Unlock again: export BW_SESSION=\"\$(bw unlock --raw)\"" >&2; exit 1; }

sealed="$(kubectl -n vault exec vault-0 -c vault -- vault status -format=json 2>/dev/null | jq -r .sealed || true)"
case "$sealed" in
  false) echo "Vault is already unsealed."; exit 0 ;;
  true) ;;
  *) echo "Could not read Vault's status (sealed=$sealed). Is vault-0 running?" >&2; exit 1 ;;
esac

bw get password mediasafe/vault-unseal-key --session "$BW_SESSION" \
  | jq -Rc '{key: .}' \
  | kubectl -n vault exec -i vault-0 -c vault -- sh -c \
      'wget -qO- --header "Content-Type: application/json" --post-file /dev/stdin http://127.0.0.1:8200/v1/sys/unseal' \
  | jq -r 'if .sealed then "Still sealed: progress \(.progress)/\(.t)" else "Unsealed. Vault \(.version), cluster \(.cluster_name)" end'
