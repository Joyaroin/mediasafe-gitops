#!/usr/bin/env bash
# Creates Argo CD's read-only deploy key for this repo. Run once, ever — not per cluster.
#
#   export BW_SESSION="$(bw unlock --raw)"
#   bootstrap/create-deploy-key
#
# The private half goes straight into Bitwarden as the secure note
# `mediasafe/argocd-deploy-key`, where bootstrap/install reads it on every fresh cluster.
# The public half becomes a read-only deploy key on Joyaroin/mediasafe-gitops. The key never
# lands anywhere else: it is generated in a temp directory that is deleted on exit.
set -euo pipefail

ITEM=mediasafe/argocd-deploy-key
REPO=Joyaroin/mediasafe-gitops

: "${BW_SESSION:?Unlock Bitwarden first: export BW_SESSION=\"\$(bw unlock --raw)\"}"
bw unlock --check --session "$BW_SESSION" >/dev/null 2>&1 \
  || { echo "BW_SESSION is stale. Unlock again: export BW_SESSION=\"\$(bw unlock --raw)\"" >&2; exit 1; }

if bw get item "$ITEM" --session "$BW_SESSION" >/dev/null 2>&1; then
  echo "$ITEM already exists in Bitwarden. Delete it (and the deploy key on GitHub) first to rotate." >&2
  exit 1
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
ssh-keygen -q -t ed25519 -N "" -C "argocd@mediasafe" -f "$tmp/key"

# Bitwarden first: if storing fails, no deploy key exists on GitHub without its private half.
bw get template item --session "$BW_SESSION" \
  | jq --rawfile key "$tmp/key" \
      '.type = 2 | .secureNote = {type: 0} | .login = null | .name = "'"$ITEM"'" | .notes = $key' \
  | bw encode \
  | bw create item --session "$BW_SESSION" >/dev/null
bw sync --session "$BW_SESSION" >/dev/null

# Read-only is gh's default; --allow-write is never passed.
gh repo deploy-key add "$tmp/key.pub" --repo "$REPO" --title "argocd (read-only)"

echo "Stored $ITEM in Bitwarden and added the read-only deploy key to $REPO."
