#!/bin/sh
# Installs k3s on hamon, the server VM on the Proxmox host jonathan, with the settings the Linode node
# gets from MediaSafe's infra/terraform/cloud-init.yaml.tftpl. Two differences, both for home:
#   - the node is named for the machine, not the app, because more than MediaSafe will run here;
#   - the API server's certificate also names the node's Tailscale address, so kubectl works from
#     the Mac over the tailnet.
# Run once per machine, on the node, as root:
#   scp bootstrap/install-k3s hamon: && ssh -t hamon sudo sh install-k3s
set -eu

K3S_VERSION="v1.36.4+k3s1" # the same as Linode; upgrades are a change here

# Security updates install themselves; reboots never happen on their own. A reboot seals Vault,
# so it is done by hand, followed by an unseal.
cat > /etc/apt/apt.conf.d/52homelab-no-reboot <<'EOF'
Unattended-Upgrade::Automatic-Reboot "false";
EOF

# cloud-init has done its job by now; from here the machine is configured by this script. Left on,
# it treats any change to Proxmox's cloud-init drive as a new machine and regenerates the SSH host
# keys. That drive changes without anyone touching it: Proxmox copies the host's DNS search domain
# into it at each VM start, and on the host Tailscale rewrites that file during boot.
touch /etc/cloud/cloud-init.disabled

# Vault's data directory. On Linode it is a separate block volume mounted here; at home it is a
# directory on the VM's disk at the same path, so Vault's PersistentVolume keeps its path.
mkdir -p /mnt/vault-data/raft

mkdir -p /etc/rancher/k3s
cat > /etc/rancher/k3s/config.yaml <<'EOF'
node-name: hamon
# Traefik is installed and owned by Argo CD, not bundled with k3s.
disable:
  - traefik
# Kubernetes Secrets are encrypted in k3s's datastore. Without this, every secret External
# Secrets copies out of Vault sits in plaintext on this disk.
secrets-encryption: true
write-kubeconfig-mode: "0600"
tls-san:
  - hamon
  - hamon.tailf69bc5.ts.net
  - 100.96.209.92
EOF

# ── Firewall ───────────────────────────────────────────────────────────────────────────────
# The router forwards no ports, but every device on the home network could otherwise reach the
# API server and kubelet. So the API is reachable over the tailnet only, and SSH from the LAN too,
# so a broken Tailscale doesn't lock you out. Tailscale's own ts-input chain already accepts
# everything on tailscale0; the tailscale0 rules here say the same thing in case it stops doing so.
ufw default deny incoming
ufw default allow outgoing
ufw allow from 192.168.2.0/24 to any port 22 proto tcp comment 'SSH from the home LAN'
ufw allow in on tailscale0 to any port 22 proto tcp comment 'SSH over Tailscale'
ufw allow in on tailscale0 to any port 6443 proto tcp comment 'k3s API over Tailscale'
# Pods reach the API server and the kubelet on the node's address (CoreDNS, metrics-server).
ufw allow from 10.42.0.0/16 to any comment 'k3s pods'
ufw allow from 10.43.0.0/16 to any comment 'k3s services'
# The agent, hermit, joins over the LAN, not Tailscale, from its DHCP reservation. These are open
# for its address only, never the whole LAN: the API (agent to server), the kubelet (server and
# metrics-server to each node), and flannel's VXLAN pod network (both ways). install-k3s-agent
# opens the same on hermit for this node's address.
ufw allow from 192.168.2.211 to any port 6443 proto tcp comment 'k3s API from hermit'
ufw allow from 192.168.2.211 to any port 10250 proto tcp comment 'kubelet from hermit'
ufw allow from 192.168.2.211 to any port 8472 proto udp comment 'flannel VXLAN from hermit'
ufw --force enable

curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="$K3S_VERSION" sh -

# A copy of the admin kubeconfig for adham, so it can be fetched to the Mac without sudo. k3s's
# kubectl reads only /etc/rancher/k3s/k3s.yaml unless KUBECONFIG says otherwise, so point it here.
install -d -o adham -g adham -m 0700 /home/adham/.kube
install -o adham -g adham -m 0600 /etc/rancher/k3s/k3s.yaml /home/adham/.kube/config
# shellcheck disable=SC2016 # $HOME is for .bashrc to expand, not this script
grep -q '^export KUBECONFIG=' /home/adham/.bashrc ||
  echo 'export KUBECONFIG=$HOME/.kube/config' >> /home/adham/.bashrc

k3s kubectl get nodes -o wide
